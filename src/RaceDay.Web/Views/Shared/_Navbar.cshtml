@model SessionUser?
@{
    var user = Model;
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Active(string navArea, string navController, string? navAction = null) =>
        string.Equals(area, navArea, StringComparison.OrdinalIgnoreCase)
        && string.Equals(controller, navController, StringComparison.OrdinalIgnoreCase)
        && (navAction is null || string.Equals(action, navAction, StringComparison.OrdinalIgnoreCase))
            ? "active" : string.Empty;

    string Current(string navArea, string navController, string? navAction = null) =>
        Active(navArea, navController, navAction) == "active" ? "page" : "false";
}

<nav class="navbar navbar-expand-lg rd-navbar" data-bs-theme="dark" aria-label="Main navigation">
    <div class="container">
        <a class="navbar-brand rd-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo.svg" alt="" /><span class="rd-wordmark">Race<span>Day</span></span>
        </a>

        @if (user is not null)
        {
            <span class="rd-role-chip rd-role-chip--@user.Role.ToLowerInvariant()">@user.Role</span>
        }

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav"
                aria-controls="rdNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="rdNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (user is null)
                {
                    <li class="nav-item">
                        <a class="nav-link @Active("", "Home")" aria-current="@Current("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                }
                else if (user.IsOrganiser)
                {
                    <li class="nav-item">
                        <a class="nav-link @Active("Organiser", "Dashboard")" aria-current="@Current("Organiser", "Dashboard")" asp-area="Organiser" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Active("Organiser", "Events") == "active" && action != "Create" ? "active" : "") @Active("Organiser", "Categories") @Active("Organiser", "Enrolments") @Active("Organiser", "Results")"
                           asp-area="Organiser" asp-controller="Events" asp-action="Index">
                            <i class="bi bi-calendar-event"></i> My events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Organiser", "Events", "Create")" aria-current="@Current("Organiser", "Events", "Create")" asp-area="Organiser" asp-controller="Events" asp-action="Create">
                            <i class="bi bi-plus-circle"></i> New event
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link @Active("Participant", "Events")" aria-current="@Current("Participant", "Events")" asp-area="Participant" asp-controller="Events" asp-action="Index">
                            <i class="bi bi-search"></i> Find events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Participant", "Enrolments")" aria-current="@Current("Participant", "Enrolments")" asp-area="Participant" asp-controller="Enrolments" asp-action="Index">
                            <i class="bi bi-ticket-perforated"></i> My events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Participant", "Results")" aria-current="@Current("Participant", "Results")" asp-area="Participant" asp-controller="Results" asp-action="Index">
                            <i class="bi bi-trophy"></i> My results
                        </a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-2">
                @if (user is null)
                {
                    <li class="nav-item">
                        <a class="nav-link @Active("", "Account", "Login")" asp-area="" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Sign in
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Create account</a>
                    </li>
                }
                else
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @Active("", "Profile")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <partial name="_Avatar" model="(user.ProfilePictureUrl, user.Initials, false)" />
                            <span>@user.FirstName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="px-3 py-2">
                                <div class="fw-semibold">@user.FullName</div>
                                <div class="small text-secondary">@user.Email</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-circle me-2"></i>My profile
                                </a>
                            </li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
