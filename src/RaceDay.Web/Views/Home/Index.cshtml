@model HomeViewModel
@{
    ViewData["Title"] = "Every finish line starts here";
    ViewData["FullWidth"] = true;
}

<section class="rd-hero">
    <div class="container position-relative">
        <partial name="_Flash" />
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="rd-eyebrow text-white-50">South Africa's road race hub</span>
                <h1 class="mt-3">Every finish line <em>starts here.</em></h1>
                <p class="lead mb-4">
                    Marathons, cycle tours, fun runs and charity walks in one place. Organisers publish events and
                    capture results; participants pick a distance, enter in seconds and follow every finish.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Create a free account
                    </a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="rd-hero-panel">
                    <div class="row text-center g-3">
                        <div class="col-4">
                            <div class="rd-hero-stat">@Model.UpcomingCount</div>
                            <div class="small text-white-50">Upcoming events</div>
                        </div>
                        <div class="col-4">
                            <div class="rd-hero-stat">3</div>
                            <div class="small text-white-50">Disciplines</div>
                        </div>
                        <div class="col-4">
                            <div class="rd-hero-stat">9</div>
                            <div class="small text-white-50">Provinces</div>
                        </div>
                    </div>
                    <hr class="border-light opacity-25 my-4" />
                    <ul class="list-unstyled mb-0 d-grid gap-2">
                        <li><i class="bi bi-check2-circle text-warning me-2"></i>Enter a run, walk or ride in under a minute</li>
                        <li><i class="bi bi-check2-circle text-warning me-2"></i>See your race number and entry status instantly</li>
                        <li><i class="bi bi-check2-circle text-warning me-2"></i>Track finish times and placings across every race</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="rd-step">
                <div class="rd-step-icon"><i class="bi bi-megaphone-fill"></i></div>
                <h3>Organisers publish</h3>
                <p class="text-secondary mb-0">Create an event with its banner, add distance and age categories, and open entries when you are ready.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-step">
                <div class="rd-step-icon rd-step-icon--mint"><i class="bi bi-ticket-perforated-fill"></i></div>
                <h3>Participants enter</h3>
                <p class="text-secondary mb-0">Browse by province, discipline and date, choose a category and get your race number straight away.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-step">
                <div class="rd-step-icon rd-step-icon--navy"><i class="bi bi-trophy-fill"></i></div>
                <h3>Everyone finishes</h3>
                <p class="text-secondary mb-0">Results are captured after the race, so every runner sees their time and their place in the field.</p>
            </div>
        </div>
    </div>
</section>

<section class="container pb-5">
    <div class="rd-page-header">
        <div>
            <span class="rd-eyebrow">On the calendar</span>
            <h2 class="mt-2 mb-0">Upcoming events</h2>
        </div>
        <a class="btn btn-light-subtle" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Participant/Events">
            See every event <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (!Model.ApiAvailable)
    {
        <div class="rd-card rd-empty">
            <i class="bi bi-cloud-slash"></i>
            <h3>Events are taking a breather</h3>
            <p class="mb-0">We could not load the event calendar just now. Please try again in a moment.</p>
        </div>
    }
    else if (Model.UpcomingEvents.Count == 0)
    {
        <div class="rd-card rd-empty">
            <i class="bi bi-calendar-x"></i>
            <h3>No upcoming events yet</h3>
            <p class="mb-0">Organisers are lacing up. Check back soon.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model.UpcomingEvents)
            {
                <div class="col-md-6 col-xl-4">
                    <partial name="_EventCard" model="ev" />
                </div>
            }
        </div>
    }
</section>
