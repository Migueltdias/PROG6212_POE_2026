@model LoginViewModel
@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Sign in";
    var showDemo = Environment.IsDevelopment() || Configuration.GetValue<bool>("Demo:ShowAccounts");
    var demoAccounts = new[]
    {
        ("thandeka.mokoena@raceday.co.za", "Organiser", "Thandeka"),
        ("pieter.vanwyk@raceday.co.za", "Organiser", "Pieter"),
        ("ayesha.patel@gmail.com", "Participant", "Ayesha"),
        ("sipho.ndlovu@gmail.com", "Participant", "Sipho")
    };
}

<div class="rd-auth">
    <aside class="rd-auth-aside">
        <div>
            <span class="rd-eyebrow text-white-50">Welcome back</span>
            <h2 class="mt-3">Your next start line is waiting.</h2>
            <ul class="list-unstyled mt-4 mb-0">
                <li><i class="bi bi-lightning-charge-fill"></i>Organisers: manage events, entries and results</li>
                <li><i class="bi bi-ticket-perforated-fill"></i>Participants: enter races and track your entries</li>
                <li><i class="bi bi-trophy-fill"></i>Everyone: see finish times and placings</li>
            </ul>
        </div>
        <img src="~/img/logo.svg" alt="" width="64" height="64" />
    </aside>

    <section class="rd-auth-form">
        <h1 class="h2 mb-1">Sign in</h1>
        <p class="text-secondary mb-4">New to RaceDay? <a asp-action="Register">Create an account</a>.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <div class="alert alert-info rd-flash mb-4" role="status">
                <i class="bi bi-lock-fill" aria-hidden="true"></i>
                <div>Please sign in to continue to that page.</div>
            </div>
        }

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-flash" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" autofocus />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
            </button>
        </form>

        @if (showDemo)
        {
            <div class="rd-demo-accounts mt-4">
                <div class="fw-semibold mb-2"><i class="bi bi-person-badge me-1"></i>Demo accounts (password <code>RaceDay@@2026</code>)</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var (email, role, name) in demoAccounts)
                    {
                        <button type="button" class="btn btn-sm btn-light-subtle" data-demo-email="@email" data-demo-password="RaceDay@@2026">
                            @name <span class="text-secondary">· @role</span>
                        </button>
                    }
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
