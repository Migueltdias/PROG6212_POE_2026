@using RaceDay.Web.Areas.Organiser.Models
@model CategoryEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Category.CategoryName}";
}

<nav class="rd-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Events" asp-action="Index">My events</a> <span>/</span>
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Event.EventId">@Model.Event.EventName</a> <span>/</span>
    <a asp-action="Index" asp-route-eventId="@Model.Event.EventId">Categories</a> <span>/</span> <span>Edit</span>
</nav>

<div class="rd-page-header">
    <div>
        <span class="rd-eyebrow">Edit category</span>
        <h1>@Model.Category.CategoryName</h1>
        <p>@Model.Category.EnteredCount people have entered. The field limit cannot go below that number.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Category.CategoryId" method="post" class="rd-form-section" style="max-width: 900px" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-flash" role="alert"></div>
    <partial name="_CategoryFields" for="Input" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Save category</button>
        <a class="btn btn-light-subtle" asp-action="Index" asp-route-eventId="@Model.Event.EventId">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
