@using RaceDay.Web.Areas.Organiser.Models
@model CategoriesViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = $"Categories · {ev.EventName}";
}

<nav class="rd-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Events" asp-action="Index">My events</a> <span>/</span>
    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId">@ev.EventName</a> <span>/</span> <span>Categories</span>
</nav>

<div class="rd-page-header">
    <div>
        <span class="rd-eyebrow">Category management</span>
        <h1>Categories</h1>
        <p>The distance and age categories participants can enter at <strong>@ev.EventName</strong>. Each has its own event type, fee, field limit, start time and minimum age.</p>
    </div>
    <status-badge value="@ev.EventStatus" />
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="rd-card">
            <div class="rd-card-header"><h2><i class="bi bi-signpost-split-fill"></i> @ev.Categories.Count @(ev.Categories.Count == 1 ? "category" : "categories")</h2></div>
            @if (ev.Categories.Count == 0)
            {
                <div class="rd-empty">
                    <i class="bi bi-signpost"></i>
                    <h3>No categories yet</h3>
                    <p>Add the first distance using the form. An event needs at least one before it can be published.</p>
                </div>
            }
            else
            {
                <div class="p-3 d-grid gap-3">
                    @foreach (var category in ev.Categories)
                    {
                        <div class="rd-category">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rd-category-distance">@Display.DistanceNumber(category.DistanceKm)<small>km</small></div>
                                <div>
                                    <div class="rd-category-name">@category.CategoryName</div>
                                    <div class="rd-category-facts">
                                        <span><i class="bi @Display.DisciplineIcon(category.Discipline) me-1"></i>@category.Discipline</span>
                                        <span><i class="bi bi-clock me-1"></i>@Display.Time(category.StartTime)</span>
                                        <span><i class="bi bi-person-check me-1"></i>@(category.MinimumAge)+ years</span>
                                        <span><i class="bi bi-people me-1"></i>@category.EnteredCount / @category.MaxParticipants entered</span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 ms-auto">
                                <span class="rd-category-price me-2">@Display.Money(category.EntryFee)</span>
                                @if (Model.CanChange)
                                {
                                    <a class="btn btn-sm btn-light-subtle" asp-action="Edit" asp-route-id="@category.CategoryId" aria-label="Edit @category.CategoryName"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@category.CategoryId" asp-route-eventId="@ev.EventId" method="post"
                                          data-confirm="Remove the category &quot;@category.CategoryName&quot;?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove @category.CategoryName"
                                                disabled="@(category.EnteredCount > 0)" title="@(category.EnteredCount > 0 ? "People have entered this category, so it cannot be removed" : null)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-xl-5">
        @if (Model.CanChange)
        {
            <form asp-action="Create" asp-route-eventId="@ev.EventId" method="post" class="rd-form-section" novalidate>
                <h2><i class="bi bi-plus-circle"></i> Add a category</h2>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-flash" role="alert"></div>
                <partial name="_CategoryFields" for="NewCategory" />
                <button type="submit" class="btn btn-primary w-100 mt-4"><i class="bi bi-plus-lg me-1"></i> Add category</button>
            </form>
        }
        else
        {
            <div class="rd-card rd-empty">
                <i class="bi bi-lock"></i>
                <h3>Categories are locked</h3>
                <p>This event is @ev.EventStatus.ToLowerInvariant(), so its categories can no longer change.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
