@using RaceDay.Web.Areas.Organiser.Models
@model EventListViewModel
@{
    ViewData["Title"] = "My events";
    var tabs = new (string? Status, string Label)[] { (null, "All"), ("Draft", "Drafts"), ("Published", "Published"), ("Completed", "Completed"), ("Cancelled", "Cancelled") };
}

<div class="rd-page-header">
    <div>
        <span class="rd-eyebrow">Events management</span>
        <h1>My events</h1>
        <p>Create, edit, publish and delete your events. Open an event to manage its categories, entries and results.</p>
    </div>
    <a class="btn btn-primary btn-lg" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New event</a>
</div>

<ul class="nav rd-tabs" role="tablist" aria-label="Filter by status">
    @foreach (var (status, label) in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Status == status ? "active" : "")" aria-current="@(Model.Status == status ? "page" : null)"
               asp-action="Index" asp-route-status="@status">@label</a>
        </li>
    }
</ul>

@if (Model.Page.Items.Count == 0)
{
    <div class="rd-card rd-empty">
        <i class="bi bi-calendar-plus"></i>
        <h3>@(Model.Status is null ? "You have not created an event yet" : $"No {Model.Status.ToLowerInvariant()} events")</h3>
        <p>Events you create appear here, newest event date first.</p>
        <a class="btn btn-primary" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var ev in Model.Page.Items)
        {
            <article class="rd-card overflow-hidden">
                <div class="row g-0 align-items-stretch">
                    <div class="col-md-4 col-lg-3">
                        <partial name="_EventBanner" model="ev" view-data='new ViewDataDictionary(ViewData) { ["BannerClass"] = "h-100" }' />
                    </div>
                    <div class="col-md-8 col-lg-9">
                        <div class="p-3 p-lg-4 h-100 d-flex flex-column gap-2">
                            <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                                <div>
                                    <h2 class="h3 mb-1"><a class="text-reset text-decoration-none" asp-action="Details" asp-route-id="@ev.EventId">@ev.EventName</a></h2>
                                    <div class="text-secondary small">
                                        <i class="bi bi-calendar3 text-orange me-1"></i>@Display.LongDate(ev.EventDate) · @Display.Relative(ev.EventDate, Model.Today)
                                        <span class="mx-2">|</span>
                                        <i class="bi bi-geo-alt-fill text-orange me-1"></i>@ev.VenueName, @ev.City
                                    </div>
                                </div>
                                <status-badge value="@ev.EventStatus" />
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var discipline in ev.Disciplines)
                                {
                                    <span class="rd-chip"><i class="bi @Display.DisciplineIcon(discipline)"></i>@discipline</span>
                                }
                                <span class="rd-chip"><i class="bi bi-signpost-split"></i>@Display.DistanceRange(ev.ShortestDistanceKm, ev.LongestDistanceKm)</span>
                                <span class="rd-chip"><i class="bi bi-people-fill"></i>@ev.EnteredCount entered · @ev.ConfirmedCount confirmed</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-auto pt-2">
                                <a class="btn btn-sm btn-navy" asp-action="Details" asp-route-id="@ev.EventId"><i class="bi bi-gear me-1"></i>Manage</a>
                                <a class="btn btn-sm btn-light-subtle" asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.EventId"><i class="bi bi-sliders me-1"></i>Categories</a>
                                <a class="btn btn-sm btn-light-subtle" asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@ev.EventId"><i class="bi bi-people me-1"></i>Entries</a>
                                <a class="btn btn-sm btn-light-subtle" asp-controller="Results" asp-action="Index" asp-route-eventId="@ev.EventId"><i class="bi bi-stopwatch me-1"></i>Results</a>
                                @if (ev.EventStatus is not ("Cancelled" or "Completed"))
                                {
                                    <a class="btn btn-sm btn-light-subtle" asp-action="Edit" asp-route-id="@ev.EventId"><i class="bi bi-pencil me-1"></i>Edit</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    <partial name="_Pager" model='new PagerModel(Model.Page.Page, Model.Page.TotalPages, Model.Page.TotalCount, "events")' />
}
