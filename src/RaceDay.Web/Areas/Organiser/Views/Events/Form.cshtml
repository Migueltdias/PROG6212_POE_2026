@using RaceDay.Web.Areas.Organiser.Models
@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Edit {Model.EventName}" : "Create an event";
}

<nav class="rd-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Events" asp-action="Index">My events</a>
    @if (Model.IsEdit)
    {
        <span>/</span> <a asp-action="Details" asp-route-id="@Model.EventId">@Model.EventName</a>
    }
    <span>/</span> <span>@(Model.IsEdit ? "Edit" : "New event")</span>
</nav>

<div class="rd-page-header">
    <div>
        <span class="rd-eyebrow">@(Model.IsEdit ? "Edit event" : "New event")</span>
        <h1>@(Model.IsEdit ? Model.EventName : "Create an event")</h1>
        <p>
            @if (Model.IsEdit)
            {
                <text>Update the details participants see. Distances and event types are managed per category.</text>
            }
            else
            {
                <text>New events start as a draft that only you can see. Publish it when you are ready to open entries.</text>
            }
        </p>
    </div>
    @if (Model.IsEdit)
    {
        <status-badge value="@Model.EventStatus" />
    }
</div>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-flash" role="alert"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="rd-form-section">
                <h2><i class="bi bi-card-heading"></i> The basics</h2>
                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control form-control-lg" placeholder="e.g. Durban Beachfront 10km 2027" />
                    <span asp-validation-for="EventName"></span>
                </div>
                <div>
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="The route, what makes the race special, and anything entrants should know."></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </section>

            <section class="rd-form-section">
                <h2><i class="bi bi-calendar3"></i> Date and entries</h2>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control" />
                        <span asp-validation-for="EventDate"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="StartTime" class="form-label"></label>
                        <input asp-for="StartTime" type="time" class="form-control" />
                        <span asp-validation-for="StartTime"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="RegistrationOpens" class="form-label"></label>
                        <input asp-for="RegistrationOpens" type="date" class="form-control" />
                        <span asp-validation-for="RegistrationOpens"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="RegistrationCloses" class="form-label"></label>
                        <input asp-for="RegistrationCloses" type="date" class="form-control" />
                        <span asp-validation-for="RegistrationCloses"></span>
                        <div class="form-text">Entries must close on or before the event date.</div>
                    </div>
                </div>
            </section>

            <section class="rd-form-section">
                <h2><i class="bi bi-geo-alt-fill"></i> Location</h2>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Province" class="form-label"></label>
                        <select asp-for="Province" class="form-select" data-province-select data-lat="Latitude" data-lng="Longitude">
                            <option value="">Choose a province…</option>
                            @foreach (var province in Provinces.All)
                            {
                                <option value="@province">@province</option>
                            }
                        </select>
                        <span asp-validation-for="Province"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="VenueName" class="form-label"></label>
                        <input asp-for="VenueName" class="form-control" placeholder="Start and finish venue" />
                        <span asp-validation-for="VenueName"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Latitude" class="form-label"></label>
                        <input asp-for="Latitude" type="number" step="0.000001" class="form-control" placeholder="-29.858700" />
                        <span asp-validation-for="Latitude"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Longitude" class="form-label"></label>
                        <input asp-for="Longitude" type="number" step="0.000001" class="form-control" placeholder="31.021800" />
                        <span asp-validation-for="Longitude"></span>
                    </div>
                    <div class="col-12 form-text mt-1">
                        <i class="bi bi-info-circle"></i> Choosing a province fills in its centre; adjust the coordinates to the start venue for an accurate map.
                    </div>
                </div>
            </section>

            <section class="rd-form-section">
                <h2><i class="bi bi-signpost-split-fill"></i> Distance and event type</h2>
                @if (Model.IsEdit)
                {
                    @if (Model.ExistingCategories.Count == 0)
                    {
                        <p class="text-secondary">This event has no categories yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled d-grid gap-2 mb-3">
                            @foreach (var category in Model.ExistingCategories)
                            {
                                <li class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="rd-chip"><i class="bi @Display.DisciplineIcon(category.Discipline)"></i>@category.Discipline</span>
                                    <strong>@Display.Distance(category.DistanceKm)</strong>
                                    <span class="text-secondary">@category.CategoryName · @Display.Money(category.EntryFee)</span>
                                </li>
                            }
                        </ul>
                    }
                    <a class="btn btn-light-subtle" asp-controller="Categories" asp-action="Index" asp-route-eventId="@Model.EventId">
                        <i class="bi bi-sliders me-1"></i> Manage categories
                    </a>
                }
                else
                {
                    <p class="text-secondary">Each event offers one or more categories: a distance and an event type (Run, Walk or Cycle), optionally for an age group. Add the first one now; you can add more after saving.</p>
                    <partial name="_CategoryFields" for="FirstCategory" />
                }
            </section>
        </div>

        <div class="col-xl-4">
            <section class="rd-form-section">
                <h2><i class="bi bi-image"></i> Banner image</h2>
                <div class="rd-upload">
                    <img id="bannerPreview" class="rd-upload-preview @(string.IsNullOrWhiteSpace(Model.CurrentBannerUrl) ? "d-none" : "")"
                         src="@Model.CurrentBannerUrl" alt="Banner preview" />
                    <i class="bi bi-cloud-arrow-up fs-2 text-orange d-block mb-2" aria-hidden="true"></i>
                    <label asp-for="Banner" class="form-label d-block">@(string.IsNullOrWhiteSpace(Model.CurrentBannerUrl) ? "Upload a banner" : "Replace the banner")</label>
                    <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp"
                           data-image-input="bannerPreview" data-max-bytes="@EventFormViewModel.MaxBannerBytes" />
                    <span asp-validation-for="Banner"></span>
                    <div class="form-text mt-2">JPEG, PNG, GIF or WebP, up to 5 MB. A wide photo (16:6) looks best. The image is sent to the RaceDay API, which stores it in Azure Blob Storage.</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentBannerUrl))
                {
                    <div class="form-check mt-3">
                        <input asp-for="RemoveBanner" class="form-check-input" />
                        <label asp-for="RemoveBanner" class="form-check-label"></label>
                    </div>
                }
            </section>

            <div class="rd-form-section">
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-check2-circle me-1"></i> @(Model.IsEdit ? "Save changes" : "Create event")
                </button>
                @if (Model.IsEdit)
                {
                    <a class="btn btn-light-subtle w-100 mt-2" asp-action="Details" asp-route-id="@Model.EventId">Cancel</a>
                }
                else
                {
                    <a class="btn btn-light-subtle w-100 mt-2" asp-action="Index">Cancel</a>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
