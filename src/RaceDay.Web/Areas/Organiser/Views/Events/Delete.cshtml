@model EventDetail
@{
    ViewData["Title"] = $"Delete {Model.EventName}";
}

<nav class="rd-breadcrumb" aria-label="Breadcrumb">
    <a asp-action="Index">My events</a> <span>/</span> <a asp-action="Details" asp-route-id="@Model.EventId">@Model.EventName</a> <span>/</span> <span>Delete</span>
</nav>

<div class="rd-card mx-auto overflow-hidden" style="max-width: 720px;">
    <partial name="_EventBanner" model="Model" />
    <div class="p-4 p-lg-5">
        <span class="rd-eyebrow text-danger">Delete event</span>
        <h1 class="h2 mt-2">Delete "@Model.EventName"?</h1>
        <p class="text-secondary">
            This permanently removes the event, its @Model.CategoryCount
            @(Model.CategoryCount == 1 ? "category" : "categories"), their routes, any unconfirmed entries and the banner image.
            It cannot be undone.
        </p>

        @if (Model.ConfirmedCount > 0)
        {
            <div class="alert alert-warning rd-flash" role="status">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div>This event has <strong>@Model.ConfirmedCount confirmed @(Model.ConfirmedCount == 1 ? "entry" : "entries")</strong>, so the API will refuse to delete it. Cancel the event instead to keep those entries on record.</div>
            </div>
        }

        <form asp-action="Delete" asp-route-id="@Model.EventId" method="post" class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Yes, delete it</button>
            <a class="btn btn-light-subtle" asp-action="Details" asp-route-id="@Model.EventId">Keep the event</a>
        </form>
    </div>
</div>
