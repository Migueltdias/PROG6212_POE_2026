@using RaceDay.Web.Areas.Participant.Models
@model EditEntryViewModel
@{
    var entry = Model.Enrolment!;
    ViewData["Title"] = "Update my entry";
}

<nav class="rd-breadcrumb" aria-label="Breadcrumb">
    <a asp-action="Index">My events</a> <span>/</span> <span>Update entry</span>
</nav>

<div class="rd-page-header">
    <div>
        <span class="rd-eyebrow">Update entry</span>
        <h1>@entry.EventName</h1>
        <p><span class="rd-bib me-2">@entry.RaceNumber</span> @entry.CategoryName · @Display.LongDate(entry.EventDate)</p>
    </div>
    <status-badge value="@entry.EnrolmentStatus" />
</div>

<form asp-action="Edit" asp-route-id="@entry.EnrolmentId" method="post" class="rd-form-section" style="max-width: 760px" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-flash" role="alert"></div>
    <partial name="_EntryDetailsFields" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Save</button>
        <a class="btn btn-light-subtle" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
