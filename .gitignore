# ---------------------------------------------------------------------------
# Secrets - never commit connection strings, API keys or tokens.
# Part 2 uses a JWT signing key; Part 3 adds an Azure Blob Storage connection
# string and a weather API key. All belong in user secrets or environment
# variables, not in this repository.
# ---------------------------------------------------------------------------
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
*.env
.env.*
!.env.example

# SQL Server local artefacts
*.mdf
*.ldf
*.ndf
*.bak
*.dbmdl
*.jfm

# Docker (Part 3)
docker-compose.override.yml

# Azurite (local Azure Blob Storage emulator) data
.azurite/
__blobstorage__/
__azurite_db_*.json

# Python - the ERD generation tool in tools/
__pycache__/
*.py[cod]
.venv/
venv/

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

